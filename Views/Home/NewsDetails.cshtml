@model BTL_LapTrinhWeb.Models.BaiViet
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.TieuDe;
    var baiVietLienQuan = ViewBag.BaiVietLienQuan as List<BTL_LapTrinhWeb.Models.BaiViet>;
}

<div class="container my-4 mb-5">
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm p-3 p-md-4 rounded-4 bg-white">
                <div class="mb-2">
                    <span class="badge bg-danger">@(Model.DanhMucBaiViet?.TenDanhMuc ?? "Tin tức điện lạnh")</span>
                </div>

                <h2 class="fw-bold text-dark fs-4 mb-3">@Model.TieuDe</h2>

                <div class="d-flex flex-wrap gap-3 text-muted small border-bottom pb-3 mb-4">
                    <span><i class="fa-regular fa-calendar me-1"></i>Ngày đăng: @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</span>
                    <span><i class="fa-regular fa-user me-1"></i>Tác giả: @(Model.NguoiTao?.HoTen ?? "Chuyên gia Điện Lạnh Huy Sơn")</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.TomTat))
                {
                    <div class="alert alert-light border-start border-danger border-4 fw-semibold text-secondary mb-4">
                        @Model.TomTat
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.AnhDaiDien"
                             onerror="this.src='https://dienlanhthinhphat.com.vn/wp-content/uploads/2026/10/thinh-phat-Thiet-ke-chua-co-ten-3.jpg'"
                             alt="@Model.TieuDe"
                             class="img-fluid rounded-3 border"
                             style="max-height: 400px; object-fit: cover;" />
                    </div>
                }

                <div class="article-content lh-lg text-dark">
                    @Html.Raw(Model.NoiDung)
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white mb-4">
                <h6 class="fw-bold text-dark border-bottom border-danger border-2 pb-2 mb-3">
                    <i class="fa-solid fa-newspaper text-danger me-2"></i>BÀI VIẾT LIÊN QUAN
                </h6>

                @if (baiVietLienQuan != null && baiVietLienQuan.Any())
                {
                    @foreach (var item in baiVietLienQuan)
                    {
                        <div class="d-flex align-items-start gap-2 mb-3 pb-2 border-bottom">
                            <a href="/Home/NewsDetails?slug=@item.Slug" class="flex-shrink-0">
                                <img src="@(string.IsNullOrEmpty(item.AnhDaiDien) ? "https://dienlanhthinhphat.com.vn/wp-content/uploads/2026/10/thinh-phat-Thiet-ke-chua-co-ten-3.jpg" : item.AnhDaiDien)"
                                     onerror="this.src='https://dienlanhthinhphat.com.vn/wp-content/uploads/2026/10/thinh-phat-Thiet-ke-chua-co-ten-3.jpg'"
                                     class="rounded border"
                                     style="width: 80px; height: 55px; object-fit: cover;"
                                     alt="@item.TieuDe" />
                            </a>
                            <div>
                                <a href="/Home/NewsDetails?slug=@item.Slug" class="text-dark text-decoration-none small fw-semibold d-block" style="line-height: 1.35;">
                                    @item.TieuDe
                                </a>
                                <small class="text-muted" style="font-size: 11px;">@item.NgayTao.ToString("dd/MM/yyyy")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="small text-muted mb-0">Chưa có bài viết liên quan.</p>
                }
            </div>

            <div class="card border-0 shadow-sm p-4 rounded-4 bg-danger text-white text-center">
                <i class="fa-solid fa-wand-magic-sparkles fs-2 text-warning mb-2"></i>
                <h6 class="fw-bold">Bạn chưa biết chọn công suất máy nào?</h6>
                <p class="small opacity-90 mb-3">Sử dụng công cụ tính công suất tự động của Điện Lạnh Huy Sơn chỉ trong 30 giây.</p>
                <a href="/Home/TechnicalAdvice" class="btn btn-warning fw-bold text-dark btn-sm">
                    Tư vấn chọn máy ngay
                </a>
            </div>
        </div>
    </div>
</div>