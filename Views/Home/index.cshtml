                                        <button type="button" onclick="addToCart(@sp.SanPhamId)" class="btn btn-outline-danger btn-action w-50" title="Thêm vào giỏ hàng">
                                            <i class="fa-solid fa-cart-plus"></i> <span>Thêm giỏ</span>
