<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Điện Lạnh Huy Sơn</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/Shared/AdminLayout.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        bool isAdmin = User.IsInRole("Admin");
    }

    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

    <div class="d-flex">
        <aside class="admin-sidebar" id="adminSidebar">
            <a href="/Admin" class="sidebar-brand">
                <i class="fa-solid fa-snowflake fs-4"></i>
                <div>
                    <div>HUY SƠN ADMIN</div>
                    <small class="d-block fw-normal opacity-75" style="font-size: 11px;">Hệ thống Quản trị Điện Lạnh</small>
                </div>
            </a>

            <div class="sidebar-menu">
                <div class="sidebar-label">Tổng quan</div>
                <a href="/Admin" class="sidebar-link @(currentAction == "Index" ? "active" : "")">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Bảng điều khiển</span>
                </a>

                <div class="sidebar-label mt-2">Vận hành (Admin & Staff)</div>
                <a href="/Admin/Orders" class="sidebar-link @(currentAction == "Orders" ? "active" : "")">
                    <i class="fa-solid fa-cart-flatbed"></i>
                    <span>Quản lý đơn hàng</span>
                </a>
                <a href="/Admin/Products" class="sidebar-link @(currentAction == "Products" ? "active" : "")">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    <span>Quản lý kho & Sản phẩm</span>
                </a>
                <a href="/Admin/Customers" class="sidebar-link @(currentAction == "Customers" ? "active" : "")">
                    <i class="fa-solid fa-users"></i>
                    <span>Quản lý khách hàng</span>
                </a>
                <a href="/Admin/Posts" class="sidebar-link @(currentAction == "Posts" ? "active" : "")">
                    <i class="fa-solid fa-newspaper"></i>
                    <span>Quản lý bài viết</span>
                </a>

                @if (isAdmin)
                {
                    <div class="sidebar-label mt-2 text-warning">Quản trị cấp cao (Admin)</div>
                    <a href="/Admin/Coupons" class="sidebar-link @(currentAction == "Coupons" ? "active" : "")">
                        <i class="fa-solid fa-ticket text-warning"></i>
                        <span>Quản lý khuyến mãi</span>
                    </a>
                    <a href="/Admin/Staffs" class="sidebar-link @(currentAction == "Staffs" ? "active" : "")">
                        <i class="fa-solid fa-user-shield text-warning"></i>
                        <span>Quản lý nhân viên (Staff)</span>
                    </a>
                }

                <hr class="border-secondary my-3" />
                <a href="/Home" class="sidebar-link text-info">
                    <i class="fa-solid fa-store"></i>
                    <span>Về trang bán hàng (Xem)</span>
                </a>
                <a href="/Account/Logout" class="sidebar-link text-danger">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Đăng xuất</span>
                </a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light border d-lg-none" onclick="toggleSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h5 class="m-0 fw-bold text-dark d-none d-sm-block">@ViewData["Title"]</h5>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge @(isAdmin ? "bg-danger" : "bg-primary") px-3 py-2 rounded-pill">
                        <i class="fa-solid @(isAdmin ? "fa-crown" : "fa-id-badge") me-1"></i>
                        @(isAdmin ? "QUẢN TRỊ VIÊN (ADMIN)" : "NHÂN VIÊN (STAFF)")
                    </span>
                    <div class="d-flex align-items-center gap-2 border-start ps-3">
                        <i class="fa-solid fa-circle-user fs-4 text-secondary"></i>
                        <div class="small">
                            <strong class="d-block text-dark">@User.Identity?.Name</strong>
                        </div>
                    </div>
                </div>
            </header>

            <main class="p-3 p-md-4 flex-grow-1">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="bg-white border-top py-3 px-4 text-center small text-muted">
                &copy; 2026 Hệ thống Quản trị Điện Lạnh Huy Sơn
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function toggleSidebar() {
                document.getElementById('adminSidebar').classList.toggle('show');
                document.getElementById('sidebarBackdrop').classList.toggle('show');
            }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>