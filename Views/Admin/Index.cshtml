@model BTL_LapTrinhWeb.Models.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tổng quan hệ thống";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="row g-3 mb-4">
    @if (isAdmin)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card bg-white p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-semibold text-uppercase">Tổng doanh thu</small>
                        <h4 class="fw-bold text-danger mt-1 mb-0">@Model.TongDoanhThu.ToString("N0") ₫</h4>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-sack-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card bg-white p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-semibold text-uppercase">SP sắp hết kho</small>
                        <h4 class="fw-bold text-danger mt-1 mb-0">@Model.SanPhamSapHetHang.Count mẫu</h4>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-triangle-exclamation fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card bg-white p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted fw-semibold text-uppercase">Đơn chờ xử lý</small>
                    <h4 class="fw-bold text-dark mt-1 mb-0">@Model.DonChoXuLy <span class="fs-6 fw-normal text-muted">/ @Model.TongDonHang đơn</span></h4>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-clock-rotate-left fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card bg-white p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted fw-semibold text-uppercase">Tổng khách hàng</small>
                    <h4 class="fw-bold text-dark mt-1 mb-0">@Model.TongKhachHang</h4>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-users fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card bg-white p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted fw-semibold text-uppercase">
                        @(isAdmin ? "Nhân viên (Staff)" : "Tổng sản phẩm")
                    </small>
                    <h4 class="fw-bold text-dark mt-1 mb-0">
                        @(isAdmin ? Model.TongNhanVien : Model.TongSanPham)
                    </h4>
                </div>
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid @(isAdmin ? "fa-user-tie" : "fa-boxes-stacked") fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isAdmin)
{
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-8">
            <div class="card stat-card bg-white p-3 p-md-4 h-100">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-chart-column text-danger me-2"></i>BIỂU ĐỒ DOANH THU 6 THÁNG GẦN NHẤT
                </h6>
                <div style="height: 290px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card stat-card bg-white p-3 p-md-4 h-100">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-chart-pie text-primary me-2"></i>TỶ LỆ TRẠNG THÁI ĐƠN HÀNG
                </h6>
                <div class="d-flex align-items-center justify-content-center" style="height: 290px;">
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card stat-card bg-white p-3 p-md-4 h-100">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h6 class="fw-bold text-dark m-0">
                    <i class="fa-solid fa-cart-flatbed text-danger me-2"></i>ĐƠN HÀNG MỚI NHẤT
                </h6>
                <a href="/Admin/Orders" class="small text-danger text-decoration-none fw-semibold">
                    Quản lý tất cả đơn <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light text-nowrap">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody class="text-nowrap">
                        @foreach (var dh in Model.DonHangMoiNhat)
                        {
                            <tr>
                                <td class="fw-bold text-danger">#@dh.MaDonHang</td>
                                <td>
                                    <div class="fw-semibold">@dh.TenNguoiNhan</div>
                                    <small class="text-muted">@dh.SoDienThoaiNhan</small>
                                </td>
                                <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">@dh.TongThanhToan.ToString("N0") ₫</td>
                                <td>
                                    <span class="badge @(dh.TrangThaiThanhToan == "Paid" ? "bg-success" : "bg-secondary")">
                                        @(dh.TrangThaiThanhToan == "Paid" ? "Đã thu tiền" : "Chưa thu")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(dh.TrangThaiDonHang == "Completed" ? "bg-success" : dh.TrangThaiDonHang == "Cancelled" ? "bg-secondary" : "bg-warning text-dark")">
                                        @dh.TrangThaiDonHang
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card stat-card bg-white p-3 p-md-4 h-100">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h6 class="fw-bold text-dark m-0">
                    <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>SẮP HẾT HÀNG TRONG KHO
                </h6>
                <a href="/Admin/Products" class="small text-danger text-decoration-none fw-semibold">Nhập kho</a>
            </div>
            <ul class="list-group list-group-flush small">
                @foreach (var sp in Model.SanPhamSapHetHang)
                {
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div class="me-2 overflow-hidden">
                            <div class="fw-semibold text-dark text-truncate" title="@sp.TenSanPham">@sp.TenSanPham</div>
                            <small class="text-muted">Mã: @sp.MaSanPham</small>
                        </div>
                        <span class="badge @(sp.SoLuongTon <= 0 ? "bg-danger" : "bg-warning text-dark") rounded-pill flex-shrink-0">
                            Còn @sp.SoLuongTon
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @if (isAdmin)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const revCtx = document.getElementById('revenueChart').getContext('2d');
            new Chart(revCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NhanThang)),
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoThang)),
                        backgroundColor: 'rgba(220, 53, 69, 0.8)',
                        borderColor: '#dc3545',
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } }
                }
            });

            const statusCtx = document.getElementById('orderStatusChart').getContext('2d');
            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Chờ xử lý', 'Đang xử lý/Giao', 'Hoàn thành', 'Đã hủy'],
                    datasets: [{
                        data: [@Model.DonChoXuLy, @Model.SoDonDangGiao, @Model.SoDonHoanThanh, @Model.SoDonDaHuy],
                        backgroundColor: ['#ffc107', '#0d6efd', '#198754', '#6c757d']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
        </script>
    }
}