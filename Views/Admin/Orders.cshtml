@model List<BTL_LapTrinhWeb.Models.DonHang>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý đơn hàng";
    string currentStatus = ViewBag.CurrentStatus ?? "All";
}

<div class="card stat-card bg-white p-3 p-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom pb-3 mb-3">
        <div class="d-flex flex-wrap gap-2">
            <a href="/Admin/Orders?status=All" class="btn btn-sm @(currentStatus == "All" ? "btn-danger" : "btn-outline-secondary")">Tất cả</a>
            <a href="/Admin/Orders?status=Pending" class="btn btn-sm @(currentStatus == "Pending" ? "btn-danger" : "btn-outline-secondary")">Chờ xác nhận</a>
            <a href="/Admin/Orders?status=Confirmed" class="btn btn-sm @(currentStatus == "Confirmed" ? "btn-danger" : "btn-outline-secondary")">Đã xác nhận</a>
            <a href="/Admin/Orders?status=Shipping" class="btn btn-sm @(currentStatus == "Shipping" ? "btn-danger" : "btn-outline-secondary")">Đang giao & lắp</a>
            <a href="/Admin/Orders?status=Completed" class="btn btn-sm @(currentStatus == "Completed" ? "btn-danger" : "btn-outline-secondary")">Hoàn thành</a>
            <a href="/Admin/Orders?status=Cancelled" class="btn btn-sm @(currentStatus == "Cancelled" ? "btn-danger" : "btn-outline-secondary")">Đã hủy</a>
        </div>
        <span class="small text-muted">Hiển thị: <strong>@Model.Count</strong> đơn hàng</span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle small mb-0">
            <thead class="table-light text-nowrap">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng & Địa chỉ</th>
                    <th>Sản phẩm đặt</th>
                    <th>Tổng thanh toán</th>
                    <th>Cập nhật trạng thái (Lưu lịch sử & Hoàn kho)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-danger text-nowrap">
                            #@item.MaDonHang
                            <small class="d-block text-muted fw-normal">@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
                        </td>
                        <td style="min-width: 220px;">
                            <div class="fw-bold text-dark">@item.TenNguoiNhan - @item.SoDienThoaiNhan</div>
                            <div class="text-muted">@item.DiaChiNhan</div>
                            @if (!string.IsNullOrEmpty(item.GhiChu))
                            {
                                <small class="text-danger fst-italic">Ghi chú: @item.GhiChu</small>
                            }
                        </td>
                        <td style="min-width: 220px;">
                            <ul class="list-unstyled mb-0">
                                @foreach (var ct in item.ChiTietDonHangs)
                                {
                                    <li>• @ct.TenSanPham <strong>(x@(ct.SoLuong))</strong></li>
                                }
                            </ul>
                        </td>
                        <td class="text-nowrap">
                            <div class="fw-bold text-danger fs-6">@item.TongThanhToan.ToString("N0") ₫</div>
                            @if (item.TienGiamGia > 0)
                            {
                                <small class="d-block text-success">Đã giảm: -@item.TienGiamGia.ToString("N0")₫</small>
                            }
                            <span class="badge bg-light text-dark border mt-1">@item.PhuongThucThanhToan</span>
                        </td>
                        <td style="min-width: 280px;">
                            <form asp-action="UpdateOrderStatus" asp-controller="Admin" method="post" class="d-flex flex-column gap-2">
                                <input type="hidden" name="donHangId" value="@item.DonHangId" />
                                <div class="d-flex gap-1">
                                    <select name="trangThaiDonHang" class="form-select form-select-sm">
                                        <option value="Pending" selected="@(item.TrangThaiDonHang == "Pending" ? "selected" : null)">Chờ xác nhận</option>
                                        <option value="Confirmed" selected="@(item.TrangThaiDonHang == "Confirmed" ? "selected" : null)">Đã xác nhận</option>
                                        <option value="Packing" selected="@(item.TrangThaiDonHang == "Packing" ? "selected" : null)">Đang đóng gói</option>
                                        <option value="Shipping" selected="@(item.TrangThaiDonHang == "Shipping" ? "selected" : null)">Đang giao hàng</option>
                                        <option value="Completed" selected="@(item.TrangThaiDonHang == "Completed" ? "selected" : null)">Hoàn thành</option>
                                        <option value="Cancelled" selected="@(item.TrangThaiDonHang == "Cancelled" ? "selected" : null)">Hủy đơn (Hoàn kho)</option>
                                    </select>

                                    <select name="trangThaiThanhToan" class="form-select form-select-sm">
                                        <option value="Unpaid" selected="@(item.TrangThaiThanhToan == "Unpaid" ? "selected" : null)">Chưa thu tiền</option>
                                        <option value="Paid" selected="@(item.TrangThaiThanhToan == "Paid" ? "selected" : null)">Đã thanh toán</option>
                                        <option value="Refunded" selected="@(item.TrangThaiThanhToan == "Refunded" ? "selected" : null)">Hoàn tiền</option>
                                    </select>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="text" name="ghiChu" class="form-control" placeholder="Ghi chú xử lý..." />
                                    <button type="submit" class="btn btn-danger fw-semibold">Lưu</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>