@model List<BTL_LapTrinhWeb.Models.SanPham>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý kho hàng & Sản phẩm";
    var danhMucs = ViewBag.DanhMucs as List<BTL_LapTrinhWeb.Models.DanhMuc>;
    var thuongHieus = ViewBag.ThuongHieus as List<BTL_LapTrinhWeb.Models.ThuongHieu>;
    int? selectedDanhMuc = ViewBag.SelectedDanhMuc as int?;
}

<div class="card stat-card bg-white p-3 p-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom pb-3 mb-3">
        <form method="get" action="/Admin/Products" class="d-flex flex-wrap align-items-center gap-2">
            <select name="danhMucId" class="form-select form-select-sm" style="width: 190px;" onchange="this.form.submit()">
                <option value="">-- Tất cả danh mục --</option>
                @if (danhMucs != null)
                {
                    @foreach (var dm in danhMucs)
                    {
                        <option value="@dm.DanhMucId" selected="@(selectedDanhMuc == dm.DanhMucId ? "selected" : null)">
                            @dm.TenDanhMuc
                        </option>
                    }
                }
            </select>
            <div class="input-group input-group-sm" style="width: 250px;">
                <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm tên hoặc mã SP..." />
                <button type="submit" class="btn btn-secondary">
                    <i class="fa-solid fa-magnifying-glass"></i> Lọc
                </button>
            </div>
            @if (selectedDanhMuc.HasValue || !string.IsNullOrEmpty(ViewBag.Keyword as string))
            {
                <a href="/Admin/Products" class="btn btn-sm btn-outline-secondary">Xóa lọc</a>
            }
        </form>

        <button type="button" class="btn btn-sm btn-danger fw-bold px-3 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addProductModal">
            <i class="fa-solid fa-plus me-1"></i>Thêm sản phẩm mới vào kho
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle small mb-0">
            <thead class="table-light text-nowrap">
                <tr>
                    <th>Ảnh</th>
                    <th>Mã & Tên sản phẩm</th>
                    <th>Danh mục & Hãng</th>
                    <th class="text-center">Tồn kho hiện tại</th>
                    <th>Nhập thêm hàng vào kho & Cập nhật giá</th>
                    <th class="text-center">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sp in Model)
                {
                    var anh = sp.HinhAnhSanPhams?.FirstOrDefault()?.DuongDanAnh
                              ?? "https://dienlanhthinhphat.com.vn/wp-content/uploads/2026/10/thinh-phat-Thiet-ke-chua-co-ten-3.jpg";

                    <tr>
                        <td style="width: 65px;" class="text-center">
                            <img src="@anh"
                                 onerror="this.src='https://dienlanhthinhphat.com.vn/wp-content/uploads/2026/10/thinh-phat-Thiet-ke-chua-co-ten-3.jpg'"
                                 class="rounded border"
                                 style="width: 55px; height: 55px; object-fit: cover;" />
                        </td>
                        <td style="min-width: 230px;">
                            <span class="badge bg-dark mb-1">@sp.MaSanPham</span>
                            @if (sp.NoiBat) { <span class="badge bg-danger mb-1">Nổi bật</span> }
                            @if (sp.Moi) { <span class="badge bg-success mb-1">Mới</span> }
                            <div class="fw-bold text-dark">
                                <a href="/Product/ProductDetails/@sp.SanPhamId" target="_blank" class="text-dark text-decoration-none">
                                    @sp.TenSanPham
                                </a>
                            </div>
                            <small class="text-muted">Công suất: @(sp.CongSuat ?? "Tiêu chuẩn")</small>
                        </td>
                        <td class="text-nowrap">
                            <div class="fw-semibold text-dark">@(sp.DanhMuc?.TenDanhMuc ?? "Khác")</div>
                            <small class="text-muted">Hãng: @(sp.ThuongHieu?.TenThuongHieu ?? "Chính hãng")</small>
                        </td>
                        <td class="text-center text-nowrap">
                            @if (sp.SoLuongTon <= 0)
                            {
                                <span class="badge bg-danger fs-6">Hết hàng (0)</span>
                            }
                            else if (sp.SoLuongTon <= 10)
                            {
                                <span class="badge bg-warning text-dark fs-6">Sắp hết (@sp.SoLuongTon)</span>
                            }
                            else
                            {
                                <span class="badge bg-success fs-6">@sp.SoLuongTon chiếc</span>
                            }
                        </td>
                        <td style="min-width: 320px;">
                            <form asp-action="ImportStock" asp-controller="Admin" method="post" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="sanPhamId" value="@sp.SanPhamId" />
                                <div class="input-group input-group-sm" style="width: 135px;" title="Số lượng nhập thêm vào kho">
                                    <span class="input-group-text bg-success text-white fw-bold">+Nhập</span>
                                    <input type="number" name="soLuongNhap" class="form-control text-center fw-bold" value="0" min="0" max="1000" />
                                </div>
                                <div class="input-group input-group-sm" style="width: 160px;" title="Giá bán hiện tại (VNĐ)">
                                    <input type="number" name="giaBanMoi" class="form-control fw-semibold text-danger" value="@((long)sp.GiaBan)" step="10000" />
                                    <span class="input-group-text">₫</span>
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary fw-semibold text-nowrap">
                                    <i class="fa-solid fa-floppy-disk"></i> Lưu
                                </button>
                            </form>
                        </td>
                        <td class="text-center text-nowrap">
                            <form asp-action="ToggleProductStatus" asp-controller="Admin" method="post">
                                <input type="hidden" name="sanPhamId" value="@sp.SanPhamId" />
                                <button type="submit" class="btn btn-sm @(sp.TrangThai ? "btn-outline-success" : "btn-outline-secondary")">
                                    <i class="fa-solid @(sp.TrangThai ? "fa-eye" : "fa-eye-slash") me-1"></i>
                                    @(sp.TrangThai ? "Đang bán" : "Đã ẩn")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-action="CreateProduct" asp-controller="Admin" method="post" class="modal-content border-0 rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold fs-6 m-0">
                    <i class="fa-solid fa-box-open me-2"></i>THÊM SẢN PHẨM MỚI VÀO KHO
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 small">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">Mã sản phẩm <span class="text-danger">*</span></label>
                        <input type="text" name="maSanPham" class="form-control" placeholder="VD: DH-DAIKIN-9K" required />
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input type="text" name="tenSanPham" class="form-control" placeholder="VD: Điều hòa Daikin Inverter 9000 BTU..." required />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
                        <select name="danhMucId" class="form-select" required>
                            @if (danhMucs != null)
                            {
                                @foreach (var dm in danhMucs)
                                {
                                    <option value="@dm.DanhMucId">@dm.TenDanhMuc</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Thương hiệu <span class="text-danger">*</span></label>
                        <select name="thuongHieuId" class="form-select" required>
                            @if (thuongHieus != null)
                            {
                                @foreach (var th in thuongHieus)
                                {
                                    <option value="@th.ThuongHieuId">@th.TenThuongHieu</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" name="giaBan" class="form-control" placeholder="VD: 8500000" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">Giá niêm yết (VNĐ)</label>
                        <input type="number" name="giaNiemYet" class="form-control" placeholder="VD: 9800000" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">Số lượng nhập kho <span class="text-danger">*</span></label>
                        <input type="number" name="soLuongTon" class="form-control" value="20" min="0" required />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Công suất / Dung tích</label>
                        <input type="text" name="congSuat" class="form-control" placeholder="VD: 9000 BTU (1 HP) hoặc 255 Lít" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Xuất xứ</label>
                        <input type="text" name="xuatXu" class="form-control" value="Thái Lan" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Link hình ảnh sản phẩm</label>
                        <input type="text" name="duongDanAnh" class="form-control" value="https://dienlanhthinhphat.com.vn/wp-content/uploads/2026/10/thinh-phat-Thiet-ke-chua-co-ten-3.jpg" />
                    </div>
                    <div class="col-12 d-flex gap-4 pt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="noiBat" value="true" id="chkNoiBat" checked>
                            <label class="form-check-label fw-semibold" for="chkNoiBat">Hiển thị ở mục Sản phẩm Nổi bật</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="moi" value="true" id="chkMoi" checked>
                            <label class="form-check-label fw-semibold" for="chkMoi">Hiển thị ở mục Sản phẩm Mới</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-danger btn-sm fw-bold px-4">Lưu vào kho</button>
            </div>
        </form>
    </div>
</div>