@model BTL_LapTrinhWeb.Models.DonHang
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thanh toán mã QR - " + Model.MaDonHang;
    ViewData["HideMainNav"] = true;

    string bankId = "MB";
    string accountNo = "0918925288";
    string accountName = "CONG TY DIEN LANH HUY SON";
    long soTien = (long)Model.TongThanhToan;
    string noiDungCK = $"THANH TOAN {Model.MaDonHang}";
    string qrUrl = $"https://img.vietqr.io/image/{bankId}-{accountNo}-compact2.png?amount={soTien}&addInfo={Uri.EscapeDataString(noiDungCK)}&accountName={Uri.EscapeDataString(accountName)}";
}

<div class="container my-4 mb-5" style="max-width: 820px;">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold m-0 fs-6">
                <i class="fa-solid fa-qrcode me-2"></i>CỔNG THANH TOÁN QUÉT MÃ VIETQR / VNPAY
            </h5>
            <span class="badge bg-warning text-dark">Mã đơn: #@Model.MaDonHang</span>
        </div>

        <div class="card-body p-3 p-md-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-md-5 text-center border-end-md">
                    <div class="p-2 border rounded-4 d-inline-block bg-white shadow-sm">
                        <img src="@qrUrl"
                             alt="Mã QR Thanh Toán"
                             class="img-fluid rounded-3"
                             style="max-width: 250px;" />
                    </div>
                    <small class="d-block text-muted mt-2">
                        Mở App Ngân hàng bất kỳ để quét mã QR
                    </small>
                </div>

                <div class="col-12 col-md-7">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="fa-solid fa-building-columns text-primary me-2"></i>THÔNG TIN GIAO DỊCH CHUYỂN KHOẢN
                    </h6>

                    <div class="bg-light p-3 rounded-3 small mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Ngân hàng thụ hưởng:</span>
                            <strong class="text-dark">MB Bank (Ngân hàng Quân Đội)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <strong class="text-dark">@accountName</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Số tài khoản:</span>
                            <strong class="text-primary fs-6">@accountNo</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Số tiền thanh toán:</span>
                            <strong class="text-danger fs-5">@Model.TongThanhToan.ToString("N0") ₫</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Nội dung chuyển khoản:</span>
                            <span class="badge bg-warning text-dark fs-6">@noiDungCK</span>
                        </div>
                    </div>

                    <form action="/Checkout/xac-nhan-chuyen-khoan" method="post">
                        <input type="hidden" name="maDonHang" value="@Model.MaDonHang" />
                        <button type="submit" class="btn btn-success w-100 py-3 fw-bold text-uppercase rounded-3 shadow-sm">
                            <i class="fa-solid fa-circle-check me-2"></i>TÔI ĐÃ HOÀN TẤT THANH TOÁN
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a href="/dat-hang-thanh-cong/@Model.MaDonHang" class="small text-muted text-decoration-none">
                            Chuyển sang thanh toán tiền mặt khi nhận hàng (COD)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>