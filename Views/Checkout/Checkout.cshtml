@model BTL_LapTrinhWeb.Models.CheckoutViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thanh toán đơn hàng";
    ViewData["HideMainNav"] = true;

    int tongSoLuong = Model.CartItems.Count;
    var activeCoupons = ViewBag.ActiveCoupons as List<BTL_LapTrinhWeb.Models.KhuyenMai>;
    string? couponMsgFromCart = ViewBag.CouponMessage as string;
}

<style>
    .checkout-card {
        border-radius: 14px;
        border: 1px solid #eaeaea;
    }

    .payment-option {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 14px 16px;
        cursor: pointer;
        transition: all 0.2s ease;
        background-color: #fff;
        position: relative;
    }

        .payment-option:hover {
            border-color: #f1aeb5;
            background-color: #fffdfd;
        }

        .payment-option.active {
            border-color: #dc3545;
            background-color: #fff5f5;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.08);
        }

    .payment-logo {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.35rem;
    }

    .checkout-item-list {
        max-height: 310px;
        overflow-y: auto;
    }

    .checkout-item-img {
        width: 60px;
        height: 60px;
        object-fit: contain;
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 3px;
        background: #fff;
    }

    .summary-sticky {
        position: sticky;
        top: 90px;
    }

    .vnpay-info-box {
        border-left: 4px solid #005baa;
        background-color: #f0f7ff;
        border-radius: 8px;
    }

    .coupon-chip {
        cursor: pointer;
        border: 1px dashed #dc3545;
        background: #fff5f5;
        color: #dc3545;
        font-size: 0.75rem;
        padding: 3px 8px;
        border-radius: 6px;
        transition: all 0.2s;
    }

        .coupon-chip:hover {
            background: #dc3545;
            color: #fff;
        }

    @@media (max-width: 575.98px) {
        .payment-option {
            padding: 12px;
        }

        .payment-logo {
            width: 40px;
            height: 40px;
            font-size: 1.1rem;
        }
    }
</style>

<div class="container my-4 mb-5">
    <form action="/Checkout/xac-nhan-dat-hang" method="post" id="checkoutForm">
        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card checkout-card shadow-sm bg-white p-3 p-md-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <h5 class="fw-bold text-dark m-0 fs-6">
                            <i class="fa-solid fa-location-dot text-danger me-2"></i>1. THÔNG TIN NHẬN HÀNG & LẮP ĐẶT
                        </h5>
                        <a href="/Account/Profile" class="small text-decoration-none text-danger">
                            <i class="fa-solid fa-pen-to-square me-1"></i>Sổ địa chỉ
                        </a>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-muted">Họ và tên người nhận <span class="text-danger">*</span></label>
                            <input type="text" asp-for="NguoiNhan" class="form-control rounded-3 py-2" placeholder="Nhập họ tên người nhận" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-muted">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                            <input type="tel" asp-for="SoDienThoai" class="form-control rounded-3 py-2" placeholder="Nhập số điện thoại" required />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-muted">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                            <input type="text" asp-for="TinhThanh" class="form-control rounded-3 py-2" placeholder="VD: Hà Nội" required />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-muted">Quận / Huyện <span class="text-danger">*</span></label>
                            <input type="text" asp-for="QuanHuyen" class="form-control rounded-3 py-2" placeholder="VD: Cầu Giấy" required />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-muted">Phường / Xã <span class="text-danger">*</span></label>
                            <input type="text" asp-for="PhuongXa" class="form-control rounded-3 py-2" placeholder="VD: Dịch Vọng" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Địa chỉ chi tiết (Số nhà, ngõ, tên đường...) <span class="text-danger">*</span></label>
                            <input type="text" asp-for="DiaChiChiTiet" class="form-control rounded-3 py-2" placeholder="VD: Số 120 đường Cầu Giấy" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Ghi chú giao hàng & lắp đặt (Tùy chọn)</label>
                            <textarea asp-for="GhiChu" class="form-control rounded-3" rows="2" placeholder="VD: Giao giờ hành chính, cần mang theo thang chữ A để lắp điều hòa..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="card checkout-card shadow-sm bg-white p-3 p-md-4">
                    <h5 class="fw-bold text-dark border-bottom pb-3 mb-3 fs-6">
                        <i class="fa-solid fa-credit-card text-danger me-2"></i>2. PHƯƠNG THỨC THANH TOÁN
                    </h5>

                    <div class="d-flex flex-column gap-3">
                        <label class="payment-option active d-flex align-items-center gap-3 m-0" id="label-cod" onclick="selectPayment('COD')">
                            <input type="radio" name="PhuongThucThanhToan" value="COD" class="form-check-input mt-0" checked />
                            <div class="payment-logo bg-danger bg-opacity-10 text-danger">
                                <i class="fa-solid fa-truck-fast"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">Thanh toán khi nhận hàng (COD)</div>
                                <small class="text-muted d-block">Kiểm tra hàng, kỹ thuật viên lắp đặt hoàn tất mới thanh toán tiền mặt.</small>
                            </div>
                        </label>

                        <label class="payment-option d-flex align-items-center gap-3 m-0" id="label-vnpay" onclick="selectPayment('VNPAY')">
                            <input type="radio" name="PhuongThucThanhToan" value="VNPAY" class="form-check-input mt-0" />
                            <div class="payment-logo bg-primary bg-opacity-10 text-primary">
                                <i class="fa-solid fa-qrcode"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="fw-bold text-dark">Thanh toán trực tuyến qua cổng VietQR / VNPAY</span>
                                    <span class="badge bg-primary" style="font-size: 10px;">QR-Code / Banking</span>
                                </div>
                                <small class="text-muted d-block">Hệ thống tự động tạo mã QR chuyển khoản đúng số tiền đơn hàng.</small>
                            </div>
                        </label>

                        <div id="vnpayGuide" class="vnpay-info-box p-3 small d-none">
                            <div class="fw-bold text-primary mb-1">
                                <i class="fa-solid fa-shield-halved me-1"></i>Hướng dẫn thanh toán mã QR:
                            </div>
                            <p class="text-muted mb-0">
                                Sau khi bấm <strong>"Thanh toán qua cổng VNPAY / QR"</strong>, hệ thống sẽ hiển thị mã VietQR chính xác theo số tiền đơn hàng của bạn.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card checkout-card shadow-sm bg-white p-3 p-md-4 summary-sticky">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <h5 class="fw-bold text-dark m-0 fs-6">
                            <i class="fa-solid fa-bag-shopping text-danger me-2"></i>ĐƠN HÀNG (@tongSoLuong SẢN PHẨM)
                        </h5>
                        <a href="/Cart" class="small text-decoration-none text-danger">Sửa giỏ hàng</a>
                    </div>

                    <div class="checkout-item-list pe-1 mb-3">
                        @foreach (var item in Model.CartItems)
                        {
                            var sp = item.SanPham;
                            var anh = sp.HinhAnhSanPhams?.FirstOrDefault()?.DuongDanAnh
                                      ?? "https://dienlanhthinhphat.com.vn/wp-content/uploads/2026/10/thinh-phat-Thiet-ke-chua-co-ten-3.jpg";
                            var thanhTien = sp.GiaBan * item.SoLuong;

                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <div class="position-relative flex-shrink-0">
                                    <img src="@anh"
                                         onerror="this.src='https://dienlanhthinhphat.com.vn/wp-content/uploads/2026/10/thinh-phat-Thiet-ke-chua-co-ten-3.jpg'"
                                         alt="@sp.TenSanPham"
                                         class="checkout-item-img" />
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-secondary" style="font-size: 10px;">
                                        x@(item.SoLuong)
                                    </span>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="small fw-semibold text-dark text-truncate" title="@sp.TenSanPham">@sp.TenSanPham</div>
                                    <small class="text-muted d-block" style="font-size: 11px;">Đơn giá: @sp.GiaBan.ToString("N0")₫</small>
                                </div>
                                <div class="text-end fw-bold text-danger small flex-shrink-0">
                                    @thanhTien.ToString("N0")₫
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-danger border-end-0">
                                <i class="fa-solid fa-ticket"></i>
                            </span>
                            <input type="text" asp-for="MaKhuyenMai" id="couponInput" class="form-control border-start-0" placeholder="Nhập mã giảm giá (VD: WELCOME5)" />
                            <button type="button" class="btn btn-outline-danger fw-semibold px-3" onclick="applyCoupon()">Áp dụng</button>
                        </div>

                        <small id="couponMessage" class="d-block mt-1 @(string.IsNullOrEmpty(couponMsgFromCart) ? "" : "text-success fw-semibold")">
                            @if (!string.IsNullOrEmpty(couponMsgFromCart))
                            {
                                <i class="fa-solid fa-circle-check me-1"></i>
                                @couponMsgFromCart
                            }
                        </small>

                        @if (activeCoupons != null && activeCoupons.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach (var km in activeCoupons)
                                {
                                    <span class="coupon-chip" onclick="selectCouponChip('@km.MaKhuyenMai')" title="@km.TenKhuyenMai (Đơn tối thiểu @km.DonHangToiThieu.ToString("N0")₫)">
                                        <i class="fa-solid fa-tag me-1"></i>@km.MaKhuyenMai
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="bg-light p-3 rounded-3 mb-3">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Tạm tính:</span>
                            <strong class="text-dark">@Model.TamTinh.ToString("N0")₫</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="text-success fw-semibold">Miễn phí nội thành</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Giảm giá khuyến mãi:</span>
                            <strong class="text-success" id="discountDisplay">-@Model.GiamGia.ToString("N0")₫</strong>
                        </div>
                        <hr class="my-2 text-muted">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">TỔNG THANH TOÁN:</span>
                            <span class="fw-bold text-danger fs-4" id="totalDisplay">@Model.TongThanhToan.ToString("N0")₫</span>
                        </div>
                        <small class="text-muted d-block text-end" style="font-size: 11px;">(Đã bao gồm thuế VAT)</small>
                    </div>

                    <button type="submit" id="btnSubmitOrder" class="btn btn-danger w-100 py-3 fw-bold text-uppercase rounded-3 shadow-sm fs-6">
                        <i class="fa-solid fa-bag-shopping me-2"></i>XÁC NHẬN ĐẶT HÀNG (COD)
                    </button>

                    <div class="text-center mt-3 small text-muted" style="font-size: 12px;">
                        <i class="fa-solid fa-lock text-success me-1"></i>Thông tin giao dịch được bảo mật an toàn 100%
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        function selectCouponChip(code) {
            document.getElementById('couponInput').value = code;
            applyCoupon();
        }

        function applyCoupon() {
            const couponInput = document.getElementById('couponInput');
            const couponMessage = document.getElementById('couponMessage');
            const discountDisplay = document.getElementById('discountDisplay');
            const totalDisplay = document.getElementById('totalDisplay');

            const code = couponInput.value.trim();

            fetch(`/Checkout/ApplyCoupon?code=${encodeURIComponent(code)}`, {
                method: 'POST'
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        couponInput.value = data.code;
                        couponMessage.className = "d-block mt-1 text-success fw-semibold";
                        couponMessage.innerHTML = `<i class="fa-solid fa-circle-check me-1"></i>${data.message}`;

                        discountDisplay.innerText = `-${Number(data.giamGia).toLocaleString('vi-VN')}₫`;
                        totalDisplay.innerText = `${Number(data.tongThanhToan).toLocaleString('vi-VN')}₫`;
                    } else {
                        couponMessage.className = "d-block mt-1 text-danger fw-semibold";
                        couponMessage.innerHTML = `<i class="fa-solid fa-circle-exclamation me-1"></i>${data.message}`;

                        discountDisplay.innerText = "-0₫";
                        if (data.tongThanhToan !== undefined) {
                            totalDisplay.innerText = `${Number(data.tongThanhToan).toLocaleString('vi-VN')}₫`;
                        }
                    }
                })
                .catch(() => {
                    couponMessage.className = "d-block mt-1 text-danger";
                    couponMessage.innerText = "Không thể kết nối máy chủ, vui lòng thử lại!";
                });
        }

        function selectPayment(method) {
            const labelCod = document.getElementById('label-cod');
            const labelVnpay = document.getElementById('label-vnpay');
            const vnpayGuide = document.getElementById('vnpayGuide');
            const btnSubmit = document.getElementById('btnSubmitOrder');

            if (method === 'VNPAY') {
                labelVnpay.classList.add('active');
                labelCod.classList.remove('active');
                vnpayGuide.classList.remove('d-none');

                btnSubmit.classList.remove('btn-danger');
                btnSubmit.classList.add('btn-primary');
                btnSubmit.innerHTML = '<i class="fa-solid fa-qrcode me-2"></i>THANH TOÁN QUA CỔNG VNPAY / QR';
            } else {
                labelCod.classList.add('active');
                labelVnpay.classList.remove('active');
                vnpayGuide.classList.add('d-none');

                btnSubmit.classList.remove('btn-primary');
                btnSubmit.classList.add('btn-danger');
                btnSubmit.innerHTML = '<i class="fa-solid fa-bag-shopping me-2"></i>XÁC NHẬN ĐẶT HÀNG (COD)';
            }
        }
    </script>
}