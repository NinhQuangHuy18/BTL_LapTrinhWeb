@model BTL_LapTrinhWeb.Models.DonHang
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đặt hàng thành công";
    ViewData["HideMainNav"] = true;
    bool daThanhToan = Model.TrangThaiThanhToan == "Paid";
}

<div class="container my-4 mb-5" style="max-width: 720px;">
    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-3" style="width: 72px; height: 72px;">
                <i class="fa-solid fa-check fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">ĐẶT HÀNG THÀNH CÔNG!</h3>
            <p class="text-muted small mb-0">
                Cảm ơn <strong>@Model.TenNguoiNhan</strong> đã tin tưởng mua sắm tại Điện Lạnh Huy Sơn.
            </p>
        </div>

        <div class="bg-light rounded-3 p-3 p-md-4 mb-4 border">
            <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-2 mb-3">
                <div>
                    <span class="text-muted small">Mã đơn hàng:</span>
                    <strong class="text-danger fs-5 ms-1">#@Model.MaDonHang</strong>
                </div>
                <span class="badge @(daThanhToan ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                    @(daThanhToan ? "Đã thanh toán chuyển khoản" : "Thanh toán khi nhận hàng (COD)")
                </span>
            </div>

            <div class="row g-2 small mb-3">
                <div class="col-12 col-sm-4 text-muted">Người nhận hàng:</div>
                <div class="col-12 col-sm-8 fw-semibold text-sm-end text-dark">@Model.TenNguoiNhan - @Model.SoDienThoaiNhan</div>

                <div class="col-12 col-sm-4 text-muted">Địa chỉ giao & lắp đặt:</div>
                <div class="col-12 col-sm-8 fw-semibold text-sm-end text-dark">@Model.DiaChiNhan</div>

                <div class="col-12 col-sm-4 text-muted">Thời gian đặt:</div>
                <div class="col-12 col-sm-8 text-sm-end text-dark">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            @if (Model.ChiTietDonHangs != null && Model.ChiTietDonHangs.Any())
            {
                <div class="border-top pt-3 mb-3">
                    <div class="fw-bold small text-dark mb-2">Danh sách sản phẩm đã đặt:</div>
                    <ul class="list-group list-group-flush small rounded-3 border">
                        @foreach (var ct in Model.ChiTietDonHangs)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@ct.TenSanPham <strong>(x@(ct.SoLuong))</strong></span>
                                <strong class="text-dark">@ct.ThanhTien.ToString("N0") ₫</strong>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="border-top pt-2 small">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tổng tiền hàng:</span>
                    <strong>@Model.TongTienHang.ToString("N0") ₫</strong>
                </div>
                @if (Model.TienGiamGia > 0)
                {
                    <div class="d-flex justify-content-between mb-1 text-success">
                        <span>Giảm giá khuyến mãi:</span>
                        <strong>-@Model.TienGiamGia.ToString("N0") ₫</strong>
                    </div>
                }
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <span class="fw-bold text-dark fs-6">TỔNG THANH TOÁN:</span>
                    <span class="fw-bold text-danger fs-4">@Model.TongThanhToan.ToString("N0") ₫</span>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="/Account/Profile" class="btn btn-outline-danger px-4 py-2 fw-semibold">
                <i class="fa-solid fa-clock-rotate-left me-2"></i>Xem lịch sử đơn mua
            </a>
            <a href="/Home" class="btn btn-danger px-4 py-2 fw-semibold">
                <i class="fa-solid fa-house me-2"></i>Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>